FROM docker.io/python:3.15-alpine3.24 AS builder
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv
RUN apk add --no-cache --virtual .build-deps gcc musl-dev python3-dev libffi-dev
WORKDIR /zimmer/
COPY requirements.txt requirements-base.txt ./
RUN uv pip install --system --no-cache -r requirements.txt && \
    apk del .build-deps

FROM docker.io/python:3.15-alpine3.24
COPY --from=builder /usr/local/lib/python3.15/site-packages/ /usr/local/lib/python3.15/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/
RUN apk upgrade --no-cache && apk add --upgrade --no-cache expat && \
    rm /usr/local/bin/uv && \
    addgroup -S zimmporter -g 51000 && \
    adduser -S -G zimmporter -u 51000 -h /zimmer zimmporter && \
    mkdir -p /etc/ssl/certs /data/zimmer/importer
WORKDIR /zimmer/
COPY zimmporter/ ./zimmporter/
COPY api/ ./api/
COPY tasks/ ./tasks/
COPY db/ ./db/
RUN chown -R 51000:51000 /zimmer /data/zimmer
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER zimmporter
EXPOSE 8000
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000"]
