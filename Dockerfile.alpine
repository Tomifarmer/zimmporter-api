FROM docker.io/denoland/deno:alpine-2.9.4 AS deno

FROM docker.io/python:3.14-alpine3.21 AS builder
COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv
RUN apk add --no-cache --virtual .build-deps gcc musl-dev python3-dev libffi-dev
WORKDIR /zimmer/
COPY requirements.txt .
RUN uv pip install --system --no-cache -r requirements.txt && \
    apk del .build-deps

FROM docker.io/python:3.14-alpine3.21
COPY --from=builder /usr/local/lib/python3.14/site-packages/ /usr/local/lib/python3.14/site-packages/
COPY --from=builder /usr/local/bin/ /usr/local/bin/
COPY --from=deno /bin/deno /usr/local/bin/deno
RUN rm /usr/local/bin/uv && \
    apk add --no-cache ffmpeg && \
    addgroup -S zimmporter -g 51000 && \
    adduser -S -G zimmporter -u 51000 -h /zimmer zimmporter && \
    mkdir -p /etc/ssl/certs /data/zimmer/importer
WORKDIR /zimmer/
COPY zimmporter/ ./zimmporter/
COPY api/ ./api/
COPY tasks/ ./tasks/
COPY db/ ./db/
RUN chown -R 51000:51000 /zimmer /data/zimmer
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER zimmporter
EXPOSE 8000
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "8000"]
