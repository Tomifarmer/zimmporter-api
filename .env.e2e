AWS_ENDPOINT_URL="TO_SET"
AWS_ACCESS_KEY_ID="TO_SET"
AWS_SECRET_ACCESS_KEY="TO_SET"
AWS_BUCKET="TO_SET"
#AWS_USE_SSL="false"
AWS_DEFAULT_REGION="us-east-1"

# Set to "true" to require X-API-Key header on all endpoints except /health
USE_SIMPLE_AUTH="false"
# Set to "true" to enable OIDC Bearer token auth on all endpoints except /health
USE_OIDC="false"
# Comma-separated list of allowed origins. Defaults to "*" (all origins).
CORS_ALLOWED_ORIGINS="*"
# The expected API key value (only used when USE_SIMPLE_AUTH=true)
API_KEY="TO_SET"
