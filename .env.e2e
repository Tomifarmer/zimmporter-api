MINIO_ENDPOINT="TO_SET"
MINIO_ACCESS_KEY="TO_SET"
MINIO_SECRET_KEY="TO_SET"
MINIO_BUCKET="TO_SET"
#MINIO_USE_SSL="false"

# Set to "true" to require X-API-Key header on all endpoints except /health
REQUIRE_AUTH="false"
# Comma-separated list of allowed origins. Defaults to "*" (all origins).
CORS_ALLOWED_ORIGINS="*"
# The expected API key value (only used when REQUIRE_AUTH=true)
API_KEY="TO_SET"
